{
  "name": "openbuilds-cam",
  "productName": "Swarfly",
  "version": "1.5.1",
  "description": "Swarfly, a fork of OpenBuilds CAM (AGPL-3.0) — browser CAM tool that converts DXF/SVG/bitmap/Gerber to G-Code, packaged as a desktop app with Electron",
  "license": "AGPL-3.0",
  "main": "electron/main.js",
  "author": "OpenBuilds",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "check-html": "node scripts/check-html.js",
    "verify": "npm run check && npm run lint && npm run check-html",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.2"
  },
  "build": {
    "appId": "cz.novy.swarfly",
    "productName": "Swarfly",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "index.html",
      "mobile.html",
      "css/**",
      "fonts/**",
      "images/**",
      "js/**",
      "lib/**",
      "workers/**",
      "workspace/**",
      "CNAME",
      "favicon.ico",
      "manifest.json",
      "site.webmanifest",
      "browserconfig.xml",
      "*.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "Swarfly-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "language": "1029",
      "installerLanguages": [
        "cs_CZ"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Swarfly",
      "artifactName": "Swarfly-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "OpenBuildsCAM-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "OpenBuildsCAM-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Swarfly-${version}.exe",
      "splashImage": "build/splash.bmp"
    },
    "compression": "normal",
    "extraFiles": [
      {
        "from": "build/swarfly-defaults.json",
        "to": "swarfly-defaults.json"
      }
    ]
  }
}
